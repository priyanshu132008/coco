# Copy to .env and fill in the keys for the providers you use (config.json picks the model).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
# Privacy.com virtual cards (tools/payment.py) — checkout flow
COCO_PRIVACY_API_KEY=

# Telegram bot gateway (telegram_gateway/gateway.js) — long polling, no other keys needed
TELEGRAM_BOT_TOKEN=              # from @BotFather on Telegram
COCO_VAULT_TOKEN=                  # optional guard token for the /vault/fill web UI (empty = open on loopback)

# COCO_VAULT_KEY (the Fernet master vault key) is generated automatically on first vault
# use — no need to set it here. Keys can also be entered at the local dashboard
# (http://127.0.0.1:8081/setup) instead of editing this file.

# Phase 4 master residential proxy (owner-managed env, no user config):
MASTER_PROXY_SERVER=             # e.g. http://proxy.brightdata.com:22225
MASTER_PROXY_USERNAME=
MASTER_PROXY_PASSWORD=