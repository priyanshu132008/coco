{
  "name": "openinstinct",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "openinstinct": "dist/openinstinct.js"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build:core": "tsc -p packages/core/tsconfig.json",
    "start:cli": "sh build.sh && node dist/openinstinct.js",
    "live": "sh build.sh && node dist/openinstinct.js run",
    "agent": "esbuild scripts/run_agent.ts --platform=node --bundle --external:onnxruntime-node --external:playwright-extra --external:playwright --external:puppeteer-extra-plugin-stealth --external:ws --outfile=dist/run_agent.js && node dist/run_agent.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "onnxruntime-node": "^1.18.0",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}